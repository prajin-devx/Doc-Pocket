rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDocument(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 256
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 256
        && data.fileSize is number && data.fileSize >= 0
        && data.category is string && data.category.size() <= 64
        && data.isFavorite is bool
        && data.isPinned is bool
        && data.importedAt is number;
    }

    function isValidCollection(data, userId) {
      return data.id is string && data.id.size() <= 64
        && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.color is string && data.color.size() <= 16
        && data.icon is string && data.icon.size() <= 32
        && data.isSystem is bool
        && data.createdAt is number;
    }

    function isValidPreference(data, userId) {
      return data.userId == userId
        && data.sectionOrder is string && data.sectionOrder.size() <= 256
        && data.firstSection is string && data.firstSection.size() <= 64
        && data.updatedAt is number;
    }

    // User Data Subcollections - Strictly sandboxed to authenticated owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /documents/{documentId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(documentId)
          && isValidDocument(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(documentId)
          && isValidDocument(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
      }

      match /collections/{collectionId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(collectionId)
          && isValidCollection(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(collectionId)
          && isValidCollection(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
      }

      match /preferences/{prefId} {
        allow get, list, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(prefId)
          && isValidPreference(incoming(), userId);
      }
    }
  }
}
